generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // Necesario para Supabase en serverless
}

// --------------------------------------
// 👤 PERFIL PÚBLICO (Sincronizado con Auth)
// --------------------------------------

// En Supabase, el usuario real vive en "auth.users".
// Esta tabla es solo para datos públicos (Avatar, Nivel, etc).
model UserProfile {
  id         String   @id @db.Uuid // Coincide con auth.uid() de Supabase
  username   String   @unique
  email      String   @unique
  avatarUrl  String?
  reputation Int      @default(100) // Sistema de karma
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relaciones
  wallet       Wallet?
  gameAccounts GameAccount[]

  // Historial
  challengesCreated  Challenge[] @relation("Creator")
  challengesAccepted Challenge[] @relation("Challenger")

  @@map("profiles") // En Supabase se suele llamar 'profiles'
}

// Tus conexiones a juegos (Ej. Tu cuenta de Riot vinculada)
model GameAccount {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String       @db.Uuid
  platform   GamePlatform
  platformId String // ID externo (PUUID, SteamID)
  gamerTag   String
  isVerified Boolean      @default(false)

  user UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([platform, platformId])
  @@map("game_accounts")
}

// --------------------------------------
// 💰 BÓVEDA FINANCIERA (ACCESO RESTRINGIDO)
// --------------------------------------

// IMPORTANTE: Habilita RLS (Row Level Security) en Supabase para esta tabla.
// Nadie debe poder escribir aquí desde el cliente. Solo el "Service Role" (NestJS).
model Wallet {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @unique @db.Uuid

  // DECIMAL es obligatorio para dinero
  balance  Decimal @default(0.00) @db.Decimal(10, 2) // Dinero libre
  escrow   Decimal @default(0.00) @db.Decimal(10, 2) // Dinero en juego
  currency String  @default("USD")

  user         UserProfile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@map("wallets")
}

model Transaction {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  walletId    String          @db.Uuid
  amount      Decimal         @db.Decimal(10, 2)
  type        TransactionType
  referenceId String? // ID del Challenge
  createdAt   DateTime        @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id])

  @@map("transactions")
}

// --------------------------------------
// 🎮 CORE DE APUESTAS
// --------------------------------------

model Challenge {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now())

  game      GameTitle
  metric    WinCondition
  betAmount Decimal         @db.Decimal(10, 2)
  status    ChallengeStatus @default(OPEN)
  gameLink  String?

  // Jugadores
  creatorId String      @db.Uuid
  creator   UserProfile @relation("Creator", fields: [creatorId], references: [id])

  challengerId String?      @db.Uuid
  challenger   UserProfile? @relation("Challenger", fields: [challengerId], references: [id])

  result MatchResult?

  @@map("challenges")
}

model MatchResult {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  challengeId String    @unique @db.Uuid
  challenge   Challenge @relation(fields: [challengeId], references: [id])

  winnerId   String?  @db.Uuid
  apiRawData Json // Guardamos la respuesta exacta de Riot/Steam
  verifiedAt DateTime @default(now())

  @@map("match_results")
}

// --------------------------------------
// 📋 ENUMS
// --------------------------------------

enum GamePlatform {
  RIOT_GAMES
  STEAM
  ACTIVISION
  EPIC_GAMES
  CHESS_COM
}

enum GameTitle {
  LEAGUE_OF_LEGENDS
  VALORANT
  COD_WARZONE
  DOTA_2
  FC_24
  CHESS
}

enum WinCondition {
  MOST_KILLS
  MATCH_WINNER
  HIGHEST_SCORE
}

enum ChallengeStatus {
  OPEN
  ACTIVE
  VALIDATING
  COMPLETED
  CANCELLED
  DISPUTED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  BET_LOCK
  BET_WIN
  BET_REFUND
  FEE
}
